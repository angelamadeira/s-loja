{
  // Loja Suzu — Worker + assets estáticos.
  // A loja (index.html, css/...) é servida como asset; o Worker (src/index.js)
  // atende só POST /api/orcamento. Ver MARKETPLACE/SETUP_Fase3_recursos.md.
  "name": "s-loja",
  "main": "src/index.js",
  "compatibility_date": "2026-07-23",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // assets = a loja. run_worker_first faz /api/* cair no Worker; o resto vira asset.
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    // SPA: qualquer rota que não seja um asset real devolve index.html (URLs reais /produtos etc.)
    "not_found_handling": "single-page-application"
  },

  // valores públicos (não são segredo)
  "vars": {
    "AVISO_TO": "somos.suzu@gmail.com",
    "AVISO_FROM": "pedidos@studiosuzu.com.br",
    "MP_PUBLIC_KEY": "TEST-07522a08-a791-40ff-8069-6c187bc12bac"
  },

  // banco dos pedidos — preencher database_id após criar o D1 (ver SETUP)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "suzu-pedidos",
      "database_id": "34e07a79-0dd1-4003-9763-4ea24c09d09a"
    }
  ],

  // bucket dos anexos (privado)
  "r2_buckets": [
    { "binding": "ANEXOS", "bucket_name": "suzu-anexos" }
  ],

  // aviso de novo pedido — restrito ao destino verificado (caminho gratuito)
  "send_email": [
    { "name": "EMAIL", "destination_address": "somos.suzu@gmail.com" }
  ],

  // Segredo (NÃO fica aqui): TURNSTILE_SECRET → `wrangler secret put TURNSTILE_SECRET`
  // (setar nos DOIS workers: produção e --env preview)

  // Ambiente de PRÉVIA/staging — worker separado `s-loja-preview` com URL estável
  // (s-loja-preview.<subdominio>.workers.dev). Testar aqui antes de promover pra prod.
  // Compartilha os mesmos D1/R2 da produção; dados de teste são apagáveis.
  "env": {
    "preview": {
      "name": "s-loja-preview",
      "assets": { "directory": ".", "binding": "ASSETS", "run_worker_first": ["/api/*"], "not_found_handling": "single-page-application" },
      "vars": { "AVISO_TO": "somos.suzu@gmail.com", "AVISO_FROM": "pedidos@studiosuzu.com.br", "MP_PUBLIC_KEY": "TEST-07522a08-a791-40ff-8069-6c187bc12bac" },
      "d1_databases": [
        { "binding": "DB", "database_name": "suzu-pedidos", "database_id": "34e07a79-0dd1-4003-9763-4ea24c09d09a" }
      ],
      "r2_buckets": [
        { "binding": "ANEXOS", "bucket_name": "suzu-anexos" }
      ],
      "send_email": [
        { "name": "EMAIL", "destination_address": "somos.suzu@gmail.com" }
      ]
    }
  }
}
